; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Piks Theft Auto"
config/description="CARNAGE : un GTA 2 en voxels, deux à quatre joueurs dans la même ville."
config/version="0.1.0"
run/main_scene="res://scenes/racine.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.051, 0.051, 0.051, 1)
boot_splash/show_image=false
config/icon="res://icone.svg"

[autoload]

Config="*res://autoload/config.gd"
Session="*res://autoload/session.gd"
Reseau="*res://autoload/reseau.gd"
Scores="*res://autoload/scores.gd"
Sons="*res://autoload/sons.gd"
Tactile="*res://autoload/tactile.gd"
Reglages="*res://autoload/reglages.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
theme/custom_font="res://polices/PixelifySans.ttf"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.051, 0.051, 0.051, 1)

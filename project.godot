; Piks-l Multijoueur — configuration du projet Godot 4.5
; Le hub à portails et ses mini-jeux. Tout le rendu est procédural :
; aucun binaire à versionner, et le style suit la palette Piks-l.

config_version=5

[application]

config/name="Piks-l Multijoueur"
config/description="Hub à portails : chaque portail lance un jeu multijoueur de 2 à 4 joueurs."
config/version="0.1.0"
run/main_scene="res://scenes/racine.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icone.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.051, 0.051, 0.051, 1)

[autoload]

Config="*res://autoload/config.gd"
Session="*res://autoload/session.gd"
Reseau="*res://autoload/reseau.gd"
Scores="*res://autoload/scores.gd"
Sons="*res://autoload/sons.gd"
Tactile="*res://autoload/tactile.gd"
Reglages="*res://autoload/reglages.gd"

[gui]

theme/custom_font="res://polices/PixelifySans.ttf"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.051, 0.051, 0.051, 1)
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
